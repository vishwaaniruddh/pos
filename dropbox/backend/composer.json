{
    "name": "dropbox-sku-copier/backend",
    "description": "PHP 8.2 REST API + CLI Worker for Dropbox SKU File Copier",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "worker": "php src/Worker/worker.php"
    },
    "config": {
        "optimize-autoloader": true
    }
}

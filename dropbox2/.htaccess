Options -Indexes -MultiViews

RewriteEngine On

# ── CRITICAL for shared hosting subdirectory ──────────────────────────────────
# RewriteBase tells Apache where this .htaccess lives relative to web root.
# Without this, rewrites fail silently on shared hosting in subdirectories.
RewriteBase /pos/dropbox/

# ── Pass real files and the api/ folder through ───────────────────────────────
# Static assets (JS, CSS, images) and the /api/ subfolder are served directly.
# The third condition ensures we don't serve index.html for virtual API routes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_URI} ^/pos/dropbox/api/
RewriteRule ^ - [L]

# ── SPA fallback ──────────────────────────────────────────────────────────────
# Every other URL (e.g. /pos/dropbox/jobs/new, /pos/dropbox/settings) serves
# index.html so React Router can handle it client-side.
RewriteRule ^ index.html [L]

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Long-term cache for Vite hashed assets ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                  "access plus 0 seconds"
    ExpiresByType application/javascript     "access plus 1 year"
    ExpiresByType text/css                   "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
</IfModule>
